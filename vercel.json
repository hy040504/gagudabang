{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "ELECTRON_SKIP_BINARY_DOWNLOAD=1 npm install",
  "buildCommand": "npm run build:client",
  "regions": ["icn1"],
  "routes": [
    {
      "src": "/(.*)",
      "headers": { "X-Content-Type-Options": "nosniff", "X-Frame-Options": "DENY", "Referrer-Policy": "same-origin" },
      "continue": true
    },
    { "src": "/admin.html", "headers": { "X-Robots-Tag": "noindex, nofollow" }, "continue": true },
    { "src": "/", "dest": "/index.html" }
  ]
}
